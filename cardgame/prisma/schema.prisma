generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String             @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime           @default(now())
  password              String?
  updatedAt             DateTime           @updatedAt
  hasStarterDecks       Boolean            @default(false)
  berries               Int                @default(0)
  issueReports          IssueReport[]
  accountLevel          Int                @default(1)
  progressSyncedAt      DateTime?
  badges                UserBadge[]
  berryTransactions     BerryTransaction[]
  virtualDisplays       VirtualDisplay[]
  battleInvitesSent     BattleInvite[]     @relation("InviteSender")
  battleInvitesReceived BattleInvite[]     @relation("InviteReceiver")
  boosterOpenings       BoosterOpening[]
  coinTransactions      CoinTransaction[]
  decks                 Deck[]
  favorites             FavoriteCard[]
  opponentHistory       GameHistory[]      @relation("OpponentHistory")
  playerHistory         GameHistory[]      @relation("PlayerHistory")
  winnerHistory         GameHistory[]      @relation("WinnerHistory")
  gameLogs              GameLog[]
  engineGames           EngineGame[]
  opponentGames         GameState[]        @relation("OpponentGame")
  playerGames           GameState[]        @relation("PlayerGame")
  tournamentMatchesA    TournamentMatch[]  @relation("PlayerA")
  tournamentMatchesB    TournamentMatch[]  @relation("PlayerB")
  tournamentWins        TournamentMatch[]  @relation("TournamentWinner")
  tradesOffered         Trade[]            @relation("TradeOfferer")
  tradesReceived        Trade[]            @relation("TradeReceiver")
  achievements          UserAchievement[]
  userCards             UserCard[]
  inventory             UserInventory[]
  stats                 UserStats?
  accounts              Account[]
  sessions              Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Card {
  id                  String               @id @default(cuid())
  name                String
  type                String
  color               String
  cost                Int?
  power               Int?
  counter             String?
  effect              String?
  rarity              String
  imageUrl            String
  set                 String?
  attribute           String?
  attributeImage      String?
  family              String?
  ability             String?
  trigger             String?
  notes               String?
  code                String
  rarityName          String?
  setCode             String?
  isAltArt            Boolean              @default(false)
  isParallel          Boolean              @default(false)
  isSpecial           Boolean              @default(false)
  boosterCards        BoosterCard[]
  boosterOpeningCards BoosterOpeningCard[]
  rarityInfo          CardRarity?          @relation(fields: [rarityName], references: [name])
  cardSet             CardSet?             @relation(fields: [setCode], references: [code])
  deckCards           DeckCard[]
  favorites           FavoriteCard[]
  gameLogs            GameLog[]
  userCards           UserCard[]
}

model UserCard {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
}

model FavoriteCard {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
}

model CardSet {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  releaseDate DateTime?
  description String?
  imageUrl    String?
  boosters    Booster[]
  cards       Card[]
}

model CardRarity {
  id       String @id @default(cuid())
  name     String @unique
  color    String
  dropRate Float
  cards    Card[]
}

model Booster {
  id          String           @id @default(cuid())
  name        String
  description String?
  price       Int
  setCode     String
  imageUrl    String?
  cardSet     CardSet          @relation(fields: [setCode], references: [code])
  cards       BoosterCard[]
  openings    BoosterOpening[]
}

model BoosterCard {
  id          String  @id @default(cuid())
  boosterId   String
  cardId      String
  probability Float   @default(0)
  booster     Booster @relation(fields: [boosterId], references: [id], onDelete: Cascade)
  card        Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([boosterId, cardId])
}

model AdminSetting {
  id        String   @id
  value     Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  requestId   String
  requestHash String
  action      String
  targetId    String
  reason      String
  before      Json
  after       Json
  createdAt   DateTime @default(now())

  @@unique([actorId, requestId])
  @@index([createdAt, id])
  @@index([targetId, createdAt])
}

model IssueReport {
  id           String   @id @default(cuid())
  userId       String
  requestId    String
  source       String
  category     String
  description  String
  status       String   @default("NEW")
  cardSnapshot Json?
  context      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([status, createdAt, id])
}

model BoosterOpening {
  id                 String               @id @default(cuid())
  userId             String
  boosterId          String
  idempotencyKey     String?
  creditedAt         DateTime?
  resultSnapshot     Json?
  rulesSnapshot      Json?
  openedAt           DateTime             @default(now())
  // Economy links (null for openings made before Berries): the box the pack came from and the payment.
  displayId          String?
  displayIndex       Int?
  berryTransactionId String?
  display            VirtualDisplay?      @relation(fields: [displayId], references: [id], onDelete: SetNull)
  booster            Booster              @relation(fields: [boosterId], references: [id], onDelete: Restrict)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards              BoosterOpeningCard[]

  @@unique([userId, idempotencyKey])
  @@unique([displayId, displayIndex])
  @@index([userId, openedAt, id])
}

// Berry ledger: the source of truth of the balance (User.berries is its running total, updated in the same
// transaction). (userId, idempotencyKey) makes every grant, reward or purchase happen at most once.
model BerryTransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  reason         String
  idempotencyKey String
  balanceAfter   Int
  details        Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, reason, createdAt])
}

// Badge levels reached by a player (tiered badges 1..13, secret badges 1). Rewards are paid through the Berry
// ledger with one key per badge level, so a level is never paid twice.
model UserBadge {
  id         String    @id @default(cuid())
  userId     String
  badgeId    String
  level      Int
  unlockedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  seenAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// A virtual 24-pack box: its hits are spread over the packs when it is created, each opening takes the next pack.
model VirtualDisplay {
  id           String           @id @default(cuid())
  userId       String
  setCode      String
  size         Int
  plan         Json
  nextIndex    Int              @default(0)
  rulesVersion String
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  openings     BoosterOpening[]

  @@index([userId, setCode, completedAt])
}

model BoosterOpeningCard {
  id               String         @id @default(cuid())
  boosterOpeningId String
  cardId           String
  position         Int
  boosterOpening   BoosterOpening @relation(fields: [boosterOpeningId], references: [id], onDelete: Cascade)
  card             Card           @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([boosterOpeningId, position])
}

model Deck {
  id          String        @id @default(cuid())
  name        String
  description String?
  userId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    DeckVersion[]
}

model DeckVersion {
  id        String     @id @default(cuid())
  deckId    String
  name      String
  createdAt DateTime   @default(now())
  cards     DeckCard[]
  deck      Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model DeckCard {
  id            String      @id @default(cuid())
  cardId        String
  quantity      Int         @default(1)
  deckVersionId String
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  deckVersion   DeckVersion @relation(fields: [deckVersionId], references: [id], onDelete: Cascade)

  @@unique([deckVersionId, cardId])
}

model GameState {
  id                       String    @id @default(cuid())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  isActive                 Boolean   @default(true)
  playerId                 String
  opponentId               String
  currentPhase             String
  currentPlayer            String
  turnNumber               Int       @default(1)
  winner                   String?
  gameOver                 Boolean   @default(false)
  isFirstTurn              Boolean   @default(true)
  canPlayCard              Boolean   @default(false)
  canAttack                Boolean   @default(false)
  canEndTurn               Boolean   @default(false)
  hasKeptHand              Boolean   @default(false)
  playerLife               Int       @default(4)
  playerLeader             Json?
  playerDeck               Json[]
  playerHand               Json[]
  playerField              Json[]
  playerDonDeck            Json[]
  playerDonField           Json[]
  playerTrash              Json[]
  playerActiveDon          Int       @default(0)
  playerDonAddedThisTurn   Boolean   @default(false)
  playerUsedDonDeck        Json[]
  playerDiscardPile        Json[]
  opponentLife             Int       @default(4)
  opponentLeader           Json?
  opponentDeck             Json[]
  opponentHand             Json[]
  opponentField            Json[]
  opponentDonDeck          Json[]
  opponentDonField         Json[]
  opponentTrash            Json[]
  opponentActiveDon        Int       @default(0)
  opponentDonAddedThisTurn Boolean   @default(false)
  opponentUsedDonDeck      Json[]
  opponentDiscardPile      Json[]
  gameLogs                 GameLog[]
  opponent                 User      @relation("OpponentGame", fields: [opponentId], references: [id])
  player                   User      @relation("PlayerGame", fields: [playerId], references: [id])
}

// M4 server-authoritative games of the pure engine (src/game). Separate from the historic GameState model.
// `state` is the full engine GameState (hidden zones, PRNG): server-only, never returned by an API.
model EngineGame {
  id            String          @id @default(cuid())
  userId        String
  status        String          @default("ACTIVE")
  humanSeat     String
  botSeat       String
  deckRef       String
  botDeckRef    String
  botLevel      String          @default("normal")
  rulesetId     String
  engineVersion String
  version       Int
  state         Json
  result        Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  finishedAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands      EngineCommand[]

  @@index([userId, status])
  @@index([userId, finishedAt])
}

// Accepted commands, in order; (gameId, commandId) makes a retried command idempotent.
model EngineCommand {
  id            String     @id @default(cuid())
  gameId        String
  seq           Int
  commandId     String
  actorSeat     String
  type          String
  payload       Json
  resultVersion Int
  createdAt     DateTime   @default(now())
  game          EngineGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seq])
  @@unique([gameId, commandId])
}

model GameHistory {
  id         String   @id @default(cuid())
  playerId   String
  opponentId String
  winnerId   String?
  createdAt  DateTime @default(now())
  duration   Int
  opponent   User     @relation("OpponentHistory", fields: [opponentId], references: [id])
  player     User     @relation("PlayerHistory", fields: [playerId], references: [id])
  winner     User?    @relation("WinnerHistory", fields: [winnerId], references: [id])
}

model GameLog {
  id        String    @id @default(cuid())
  gameId    String
  playerId  String
  action    String
  cardId    String?
  phase     String?
  createdAt DateTime  @default(now())
  card      Card?     @relation(fields: [cardId], references: [id])
  game      GameState @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    User      @relation(fields: [playerId], references: [id])
}

model Achievement {
  id               String            @id @default(cuid())
  code             String
  title            String
  description      String
  points           Int
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id            String   @id @default(cuid())
  offerUserId   String
  requestUserId String
  status        String
  createdAt     DateTime @default(now())
  offerUser     User     @relation("TradeOfferer", fields: [offerUserId], references: [id])
  requestUser   User     @relation("TradeReceiver", fields: [requestUserId], references: [id])
}

model Tournament {
  id        String            @id @default(cuid())
  name      String
  startDate DateTime
  format    String
  prize     String?
  matches   TournamentMatch[]
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  playerAId    String
  playerBId    String
  winnerId     String?
  score        String?
  playerA      User       @relation("PlayerA", fields: [playerAId], references: [id])
  playerB      User       @relation("PlayerB", fields: [playerBId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  winner       User?      @relation("TournamentWinner", fields: [winnerId], references: [id])
}

model BattleInvite {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("InviteSender", fields: [fromUserId], references: [id])
  toUser     User     @relation("InviteReceiver", fields: [toUserId], references: [id])
}

model UserStats {
  id             String  @id @default(cuid())
  userId         String  @unique
  gamesPlayed    Int     @default(0)
  gamesWon       Int     @default(0)
  boostersOpened Int     @default(0)
  favoriteDeck   String?
  favoriteCard   String?
  winRate        Float   @default(0)
  totalPlayTime  Int     @default(0)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())
  quantity    Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model SetRules {
  id           String    @id @default(cuid())
  code         String    @unique
  rarityCounts Json
  typeCounts   Json
  boosterRules Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  name         String?
  releaseDate  DateTime?
}
